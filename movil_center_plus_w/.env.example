# ─── Base de datos ────────────────────────────────────────────────────────────
# Copia la connection string de Neon: Settings → Connection string → Pooled
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera un string aleatorio seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_string_muy_largo_y_aleatorio"
JWT_EXPIRES_IN="7d"

# ─── Cloudinary (imágenes) ────────────────────────────────────────────────────
# Crea cuenta en cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME="tu_cloud_name"
CLOUDINARY_API_KEY="tu_api_key"
CLOUDINARY_API_SECRET="tu_api_secret"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# URL del frontend en producción (Vercel). En desarrollo usa *
FRONTEND_URL="http://localhost:5173"
